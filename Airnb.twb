      <aliases enabled='yes' />
      <column datatype='integer' hidden='true' name='[Beds]' role='measure' type='quantitative' />
      <column caption=' Review Performance Score' datatype='integer' name='[Calculation_0870043818074112]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Review Scores Rating]*[Number Of Reviews]' />
      </column>
      <column caption='Price Category' datatype='string' name='[Calculation_0870043818696705]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Price]&gt;300 THEN &quot;Luxury&quot;&#13;&#10;ELSEIF [Price]&gt;150 THEN &quot;Standard&quot;&#13;&#10;ELSE &quot;Budget&quot;&#13;&#10;END' />
      </column>
      <column caption='Review Category' datatype='string' name='[Calculation_0870043820965890]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Number Of Reviews]&gt;100 THEN &quot;Highly Reviewed&quot;&#13;&#10;ELSE &quot;Lesss Reviewed&quot;&#13;&#10;END' />
      </column>
      <column caption='Host Status' datatype='string' name='[Calculation_0870043822559235]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Host Since]&lt;=TODAY() THEN &quot;Active Host&quot;&#13;&#10;ELSE &quot;New Host&quot;&#13;&#10;END' />
      </column>
      <column caption='Price Filter Category' datatype='string' name='[Calculation_0870043829039108]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Price]&gt;[Parameters].[Price Parameter] THEN &quot;Above Limit&quot;&#13;&#10;ELSE &quot;Below Limit&quot;&#13;&#10;END' />
      </column>
      <column caption='Upd_Neighbourhood' datatype='string' name='[Calculation_2055042827866113]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='ifnull([Neighbourhood],&quot;Unknown&quot;)' />
      </column>
      <column caption='RSR' datatype='string' name='[Calculation_2055042830028802]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='ifnull(STR([Review Scores Rating (bin)]),&quot;Not Rated&quot;)' />
      </column>
      <column caption='Beds_upd' datatype='integer' name='[Calculation_2055042831400963]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ifnull([Beds],0)' />
      </column>
      <column caption='Property Type upd' datatype='string' name='[Calculation_2055042842296324]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL([Property Type],&quot;Unknown&quot;)' />
      </column>
      <column caption='Calc' datatype='boolean' name='[Calculation_2055042842644485]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='ISNULL([Property Type])' />
      </column>
      <column caption='Host_Since' datatype='date' name='[Calculation_2110567987552257]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IFNULL([Host Since],DATE(&quot;01-01-2010&quot;))' />
      </column>
      <column datatype='integer' name='[Host Id]' role='dimension' type='ordinal' />
      <column datatype='date' hidden='true' name='[Host Since]' role='dimension' type='ordinal' />
      <column datatype='string' hidden='true' name='[Neighbourhood]' role='dimension' type='nominal' />
      <column datatype='string' hidden='true' name='[Property Type]' role='dimension' type='nominal' />
      <column datatype='integer' hidden='true' name='[Review Scores Rating (bin)]' role='measure' type='quantitative' />
      <column datatype='string' name='[Room Category]' role='dimension' type='nominal'>
        <calculation class='categorical-bin' column='[Room Type]' new-bin='true'>
          <bin default-name='false' value='&quot;Budget Stay&quot;'>
            <value>&quot;Private room&quot;</value>
          </bin>
          <bin default-name='false' value='&quot;Premium Stay&quot;'>
            <value>&quot;Entire home/apt&quot;</value>
          </bin>
          <bin default-name='false' value='&quot;Shared Accomodation&quot;'>
            <value>&quot;Shared room&quot;</value>
          </bin>
        </calculation>
      </column>
      <column datatype='string' name='[Room Type]' role='dimension' type='nominal' />
      <column aggregation='Sum' datatype='integer' default-format='*00000' name='[Zipcode]' role='dimension' semantic-role='[ZipCode].[Name]' type='ordinal' />
